<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Размеры взяты из .course-kit/v1/models/course_ackermann/model.sdf -->

  <!-- База (корпус) -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="base_center_z" value="0.12"/>

  <!-- Колёса: база, колея, радиус, ширина, масса -->
  <xacro:property name="wheelbase" value="0.8"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>

  <!-- Сенсоры: смещение от base_link и габариты -->
  <xacro:property name="sensor_offset_x" value="0.28"/>
  <xacro:property name="sensor_offset_z" value="0.38"/>
  <xacro:property name="sensor_size" value="0.05"/>
  <xacro:property name="sensor_mass" value="0.0333"/>

  <!-- Моменты инерции: формулы для параллелепипеда и цилиндра -->
  <xacro:property name="base_ixx" value="${base_mass * (base_width**2 + base_height**2) / 12.0}"/>
  <xacro:property name="base_iyy" value="${base_mass * (base_length**2 + base_height**2) / 12.0}"/>
  <xacro:property name="base_izz" value="${base_mass * (base_length**2 + base_width**2) / 12.0}"/>

  <xacro:property name="wheel_i_axial" value="${wheel_mass * wheel_radius**2 / 2.0}"/>
  <xacro:property name="wheel_i_perp" value="${wheel_mass * (3.0 * wheel_radius**2 + wheel_width**2) / 12.0}"/>

  <xacro:property name="sensor_i" value="${sensor_mass * (2.0 * sensor_size**2) / 12.0}"/>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_material">
          <color rgba="0.04 0.04 0.04 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_i_perp}" iyy="${wheel_i_axial}" izz="${wheel_i_perp}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="${pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sensor" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sensor_size} ${sensor_size} ${sensor_size}"/>
        </geometry>
        <material name="sensor_material">
          <color rgba="0.9 0.9 0.9 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sensor_size} ${sensor_size} ${sensor_size}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="${sensor_mass}"/>
        <inertia ixx="${sensor_i}" iyy="${sensor_i}" izz="${sensor_i}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.05 0.36 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_center_z}"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_ixx}" iyy="${base_iyy}" izz="${base_izz}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Камера, лидар и IMU жёстко приклеены к base_link -->
  <xacro:sensor name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_offset_x} 0 ${sensor_offset_z}" rpy="0 0 0"/>
  </joint>

  <xacro:sensor name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_offset_x} 0 ${sensor_offset_z}" rpy="0 0 0"/>
  </joint>

  <xacro:sensor name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_offset_x} 0 ${sensor_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- Четыре колеса с continuous-сочленениями -->
  <xacro:wheel name="front_left_wheel" x="${wheelbase / 2}" y="${track / 2}"/>
  <xacro:wheel name="front_right_wheel" x="${wheelbase / 2}" y="${-track / 2}"/>
  <xacro:wheel name="rear_left_wheel" x="${-wheelbase / 2}" y="${track / 2}"/>
  <xacro:wheel name="rear_right_wheel" x="${-wheelbase / 2}" y="${-track / 2}"/>
</robot>
